# Copy to .env on the server (chmod 600). Never commit the real .env.
# Generate values on the server; see DEPLOYMENT.md.

# Signs session cookies. python -c "import secrets;print(secrets.token_hex(32))"
NUMER_SECRET_KEY=change-me
# Encrypts stored third-party credentials. python secretbox.py
NUMER_CREDENTIAL_KEY=change-me
# SQLite database, outside the web root
NUMER_DB=/home/numerlife1/data/numerlife.db
# Public address used for links in emails, canonical and Open Graph tags
NUMER_BASE_URL=https://numer.life
# 1 = ask search engines not to index the site (keep until launch)
NUMER_NOINDEX=1
